# ============================================================
# Pacha (Green) Cover — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control.
# ============================================================

# ── Google Cloud Project ───────────────────────────────────────────────────────
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="asia-south1"

# ── Firebase / Firestore ───────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"
FIRESTORE_DATABASE_ID="(default)"

# ── Gemini API ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY_PRESCRIBE="your-gemini-api-key"
GEMINI_API_KEY_VERIFY="your-gemini-api-key"
GEMINI_API_KEY_AR_IMAGE="your-gemini-api-key"
GEMINI_API_KEY_AR_DESCRIPTION="your-gemini-api-key"
GEMINI_API_KEY_CARBON="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# ── Google Earth Engine ────────────────────────────────────────────────────────
GEE_SERVICE_ACCOUNT="your-gee-sa@project.iam.gserviceaccount.com"
GEE_KEY_FILE_PATH="./gee_key.json"

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET_NAME="your-bucket-name"

# ── Application Settings ───────────────────────────────────────────────────────
APP_ENV="development"
SECRET_KEY="generate-a-64-char-random-string-here"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-app.web.app"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Green Points ───────────────────────────────────────────────────────────────
POINTS_PER_VERIFICATION=50
POINTS_PER_ADOPTION=10

# ── Feature 1: Pacha Vision AR ─────────────────────────────────────────────────
AR_ASSETS_BASE_URL="https://storage.googleapis.com/your-ar-assets-bucket"
AR_ASSETS_BUCKET="your-ar-assets-bucket"

# ── Feature 2: Green Corridor Clustering ───────────────────────────────────────
CORRIDOR_MIN_TREES=5
CORRIDOR_RADIUS_M=100.0
POINTS_CORRIDOR_BADGE=200

# ── Feature 3: Carbon Credit & Tax Simulator ──────────────────────────────────
CARBON_CREDIT_RATE_INR_PER_TONNE=1000.0
TAX_REBATE_CO2_PER_PERCENT=20.0
TAX_REBATE_MAX_PERCENT=20.0

# ── Feature 4: Bhasha Vernacular Voice Interface ──────────────────────────────
SPEECH_DEFAULT_LANGUAGE_CODE="kn-IN"
TRANSLATION_PIVOT_LANGUAGE="en"
VOICE_ENABLE_TTS_RESPONSE=false
VOICE_AUDIO_BUCKET="your-voice-audio-bucket"
